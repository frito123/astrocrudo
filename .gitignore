# AstroCrudo - .gitignore

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Dependencias (si en el futuro se agrega Node, etc.)
node_modules/
dist/
build/

# Archivos de log y temporales
*.log
*.tmp
.env
.env.local

# Videos y archivos multimedia grandes
# Nunca commitees videos pesados al repositorio.
# Sube los videos a Cloudinary, Bunny.net, o usa Git LFS si es necesario.
# Esta regla ignora todos los .mp4 nuevos (los antiguos que ya estaban trackeados se mantienen en el historial).
assets/videos/**/*.mp4
assets/videos/**/*.mov
assets/videos/**/*.webm
assets/videos/**/*.avi

# Archivo de instrucciones local (no es necesario en el repo)
assets/videos/clasica/LEEME_VIDEOS_PLANETAS.txt

# Imágenes grandes (si las agregas)
# assets/images/**/*.psd
# assets/images/raw/

# Herramientas de despliegue locales (Netlify/Vercel)
.netlify/
.vercel/
