# AstroCrudo - .gitignore

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Dependencias (si en el futuro se agrega Node, etc.)
node_modules/
dist/
build/

# Archivos de log y temporales
*.log
*.tmp
.env
.env.local

# Videos y archivos multimedia grandes
# Reglas comentadas para poder usar `git add` normal.
# Con 10 GB de LFS disponibles, no tiene sentido bloquearlos por ahora.
# Si en el futuro se acerca al límite, se pueden volver a activar.

# assets/videos/**/*.mp4
# assets/videos/**/*.mov
# assets/videos/**/*.webm
# assets/videos/**/*.avi

# Archivo de instrucciones local (no es necesario en el repo)
assets/videos/clasica/LEEME_VIDEOS_PLANETAS.txt

# Imágenes grandes (si las agregas)
# assets/images/**/*.psd
# assets/images/raw/

# Herramientas de despliegue locales (Netlify/Vercel)
.netlify/
.vercel/
